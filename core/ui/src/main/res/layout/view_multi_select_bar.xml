<?xml version="1.0" encoding="utf-8"?>
<!-- ==========================================================================
     多选「顶栏」（M7.16 重设计，ES 文件浏览器式上/下双栏的上半）

     M7.3~M7.14 它独自承担全部动作（✕ + 计数 + 2~3 行图标文字瓦片），
     真机反馈不够美观、且动作行挤在列表上方视觉压迫大。
     M7.16 起职责拆分：
       · 顶栏（本文件）= 选择状态：N/M 计数 + 全选/取消选择 + 取消
       · 底栏 MultiSelectBottomBar = 操作：复制/剪切/删除/重命名 + 更多
     ES 的顶栏还有「区间选择」——那是新功能不是改版式，不掺进来。

     用 <merge> 让外壳直接就是 MultiSelectBar（LinearLayout），少一层嵌套。
     ========================================================================== -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ES 式计数「N/M」：选了几个 / 本目录共几项。比"已选择 N 项"信息量更大 -->
    <TextView
        android:id="@+id/selectCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="1/57" />

    <!-- 弹性空隙：把两枚操作瓦片推到右侧（ES 同款布局） -->
    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- 全选 / 取消选择（全选态切换标签）。图标上、文字下的堆排 -->
    <LinearLayout
        android:id="@+id/selectAllTile"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/selectAllIcon"
            android:layout_width="@dimen/select_top_icon"
            android:layout_height="@dimen/select_top_icon"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_select_all"
            app:tint="@color/text_primary"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/selectAllLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="全选" />
    </LinearLayout>

    <!-- 取消：退出多选模式并清空选择 -->
    <LinearLayout
        android:id="@+id/closeTile"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="@dimen/select_top_icon"
            android:layout_height="@dimen/select_top_icon"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/select_cancel"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>
</merge>
