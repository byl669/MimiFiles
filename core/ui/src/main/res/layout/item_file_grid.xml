<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gridRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/grid_tile_height"
    android:background="?attr/selectableItemBackground"
    android:foreground="@drawable/bg_row_activated"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/gridIcon"
        android:layout_width="@dimen/icon_size_grid"
        android:layout_height="@dimen/icon_size_grid"
        android:contentDescription="@null"
        android:src="@drawable/ic_file_generic"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/gridTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        tools:text="IMG_20261013.jpg" />

    <ImageView
        android:id="@+id/gridCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        tools:ignore="ContentDescription" />
</LinearLayout>
