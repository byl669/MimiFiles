<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_row_height"
    android:background="?attr/selectableItemBackground"
    android:foreground="@drawable/bg_row_activated"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/content_padding"
    android:paddingEnd="@dimen/content_padding_half">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="@dimen/icon_size_row_large"
        android:layout_height="@dimen/icon_size_row_large"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_file_generic"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="IMG_20261013.jpg" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="2.4 MB · 10-13 18:22" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

    <ImageButton
        android:id="@+id/rowMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_more"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert" />
</LinearLayout>
