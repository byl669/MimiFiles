<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/treeRow"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:background="?attr/selectableItemBackground"
    android:foreground="@drawable/bg_row_activated"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/treeArrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:padding="3dp"
        android:src="@drawable/ic_chevron_right"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/treeIcon"
        android:layout_width="@dimen/icon_size_tree"
        android:layout_height="@dimen/icon_size_tree"
        android:layout_marginStart="2dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_file_folder"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/treeLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        tools:text="内部存储" />
</LinearLayout>
