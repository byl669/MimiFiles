<?xml version="1.0" encoding="utf-8"?>
<!-- 状态色点。用 oval 而不是 ImageView + 图标：一个 10dp 的圆点能同时
     表达"颜色"与"存在"，而且换色只需要 setBackgroundTintList。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/status_stopped" />
    <size
        android:width="10dp"
        android:height="10dp" />
</shape>
