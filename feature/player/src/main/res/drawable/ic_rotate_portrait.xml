<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏时的"转竖屏"图标（M7.2 重画）：横置矩形屏幕 + 绕屏环形箭头。
  与 `ic_rotate_landscape` 同一套画法，只是屏幕姿态相反——
  两个图标要能一眼看出是"同一件事的两个方向"。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <!-- 横握的屏幕 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M8.5,9.5v5a1.5,1.5 0 0 0 1.5,1.5h8a1.5,1.5 0 0 0 1.5,-1.5v-5A1.5,1.5 0 0 0 18,8h-8a1.5,1.5 0 0 0 -1.5,1.5z" />
    <!-- 左下 / 右上两段环弧 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M4.6,7.6A8,8 0 0 1 8,5M19.4,16.4A8,8 0 0 1 16,19" />
    <!-- 环弧两端的箭头（指向逆时针 → 转回竖屏） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6.6,4.9l-2.5,2 2.8,1.7zM17.4,19.1l2.5,-2 -2.8,-1.7z" />
</vector>
