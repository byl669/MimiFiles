<?xml version="1.0" encoding="utf-8"?>
<!-- 音频预览：封面位（用类型图标占位）+ 标题 + Media3 自带的控制条 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_window"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/content_padding_double"
    android:paddingEnd="@dimen/content_padding_double">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/preview_audio_play"
        android:src="@drawable/ic_file_audio"
        app:tint="@color/icon_audio" />

    <TextView
        android:id="@+id/audio_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_padding"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/audio_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/audio_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_padding_double"
        app:show_buffering="when_playing"
        app:surface_type="none"
        app:use_controller="true" />
</LinearLayout>
