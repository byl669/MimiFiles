<?xml version="1.0" encoding="utf-8"?>
<!--
  预览页外壳。

  ## 布局要点
  · 根是 FrameLayout：图片/文本/PDF/音频四种渲染器都往 `preview_container` 里塞自己的视图，
    外壳（工具栏 / 底栏 / 进度 / 错误态）与它们**同层**，于是"点一下隐藏工具栏"只是把
    两个 View 的 visibility 改掉，不需要重排内容。
  · 工具栏与底栏都用 `layout_gravity` 贴边，并各自 `padForSystemBars`（见 PreviewActivity）——
    内容铺满全屏，只有这两条自己躲开状态栏/手势条。
  · 底栏的图标按钮带 `contentDescription`：这是无障碍的最低要求，也让冒烟脚本能用
    文本定位到它们（比记坐标稳得多）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_window">

    <!-- 渲染器容器：图片渲染器会把它刷成纯黑（相册惯例） -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/preview_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/preview_title_fallback"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <FrameLayout
        android:id="@+id/preview_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <!--
              只在"这次等待有明确原因、且可能持续很久"时才显示（目前唯一的使用者是
              「外发前把安装包抓到本地」）。笼统的转圈会让人以为卡死，而一句
              "正在准备安装包"能让用户知道该等。
            -->
            <TextView
                android:id="@+id/preview_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_padding"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/preview_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_padding_double"
        android:paddingEnd="@dimen/content_padding_double"
        android:visibility="gone">

        <TextView
            android:id="@+id/preview_message_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_message_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_padding_half"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/preview_message_action"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_padding_double"
            android:text="@string/preview_action_open_with"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/preview_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_padding"
        android:paddingTop="@dimen/content_padding_half"
        android:paddingEnd="@dimen/content_padding_half"
        android:paddingBottom="@dimen/content_padding_half">

        <TextView
            android:id="@+id/preview_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/preview_btn_reset"
            android:layout_width="@dimen/select_action_size"
            android:layout_height="@dimen/select_action_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/preview_action_reset_zoom"
            android:src="@drawable/ic_fit_screen"
            app:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/preview_btn_info"
            android:layout_width="@dimen/select_action_size"
            android:layout_height="@dimen/select_action_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/preview_action_info"
            android:src="@drawable/ic_info_outline"
            app:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/preview_btn_open_with"
            android:layout_width="@dimen/select_action_size"
            android:layout_height="@dimen/select_action_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/preview_action_open_with"
            android:src="@drawable/ic_open_in_new"
            app:tint="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
