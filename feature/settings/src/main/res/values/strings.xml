    <!-- ── 无线分享（M4）───────────────────────────────────────────
         这几项按 `ShareServer.type` 分组（方案 §10.4「与设置统一」）：
         端口是每协议各自的（FTP 2121 / HTTP 8080），混成一个"默认端口"
         会让用户改了 HTTP 却以为 FTP 也变了。 -->
    <string name="settings_group_share">无线分享</string>
    <string name="settings_share_keep_screen">保持屏幕常亮</string>
    <string name="settings_share_keep_screen_summary">分享期间不自动息屏，方便对着屏幕在电脑上操作</string>
    <string name="settings_share_stop_on_exit">退出应用自动停止分享</string>
    <string name="settings_share_stop_on_exit_summary">从最近任务划掉应用时立即停止分享服务端（建议保持开启）</string>
    <string name="settings_share_port_http">HTTP 端口</string>
    <string name="settings_share_port_ftp">FTP 端口</string>
