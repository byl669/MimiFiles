    <string name="settings_share_port_saved">已保存，下次启动分享时生效</string>

    <!-- ── 软件更新（M5）──────────────────────────────────────────
         行上的分工：**摘要说"现在是什么情况"，按钮说"现在能做什么"**。
         所以摘要句全部是状态陈述（"已是最新版本"/"发现新版本 x"），
         按钮文字全部是动作（"检查更新"/"下载更新"/"立即安装"）。
         两者混着写会让用户在同一行里看到两个动作，不知道该点哪一个。 -->
    <string name="settings_update_title">软件更新</string>
    <string name="settings_update_idle">当前版本 %1$s</string>
    <string name="settings_update_check">检查更新</string>
    <string name="settings_update_checking">正在检查…</string>
    <string name="settings_update_recheck">重新检查</string>
    <string name="settings_update_uptodate">已是最新版本（%1$s）</string>
    <!-- 尺寸是清单里的**可选**字段，缺失时走下面那条不带尺寸的句子：
         显示「约 0.0 MB」比不显示更糟 —— 它会让人以为包是空的。 -->
    <string name="settings_update_available">发现新版本 %1$s，约 %2$.1f MB</string>
    <string name="settings_update_available_no_size">发现新版本 %1$s</string>
    <string name="settings_update_download">下载更新</string>
    <string name="settings_update_downloading">正在下载 %1$d%%</string>
    <string name="settings_update_ready">更新包已就绪 %1$s</string>
    <string name="settings_update_install">立即安装</string>
    <string name="settings_update_grant">去授权</string>
    <string name="settings_update_grant_needed">需要一次性授权才能安装</string>
    <!--
      用"更新失败"而不是"检查失败"：`UpdateState.Failed` 同时覆盖"拉清单失败"与
      "下载/校验失败"两类。行上写死其中一种会让另一种的提示明显不对（下载校验失败
      却被告知"检查失败"），而用户看到的就是这一行。具体原因在详情对话框里。
    -->
    <string name="settings_update_failed_row">更新失败，点这里查看原因</string>
    <string name="settings_update_retry">重试</string>

    <!-- 更新对话框（dialog_update.xml，按状态填充） -->
    <string name="update_dialog_cancel">取消</string>
    <string name="update_dialog_later">稍后</string>
    <string name="update_dialog_close">关闭</string>
    <string name="update_dialog_title_checking">正在检查更新…</string>
