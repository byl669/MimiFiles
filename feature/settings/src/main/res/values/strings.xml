    <string name="update_dialog_detail_available">下载约 %1$.1f MB。下载完成后会自动校验完整性、签名与版本，校验不过绝不会安装。</string>
    <string name="update_dialog_detail_available_no_size">下载完成后会自动校验完整性、签名与版本，校验不过绝不会安装。</string>
    <string name="update_dialog_notes_empty">修复与优化。</string>
