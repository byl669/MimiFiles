<?xml version="1.0" encoding="utf-8"?>
<!--
  编辑页溢出菜单。

  只有一项，且只在编辑已有连接时出现。

  为什么"清除已保存的密码"需要一个显式入口，而不是靠"把密码框清空再保存"：
  密码框留空承载的是**另一种**语义（"这次不改密码"，见 connection_password_keep）。
  同一个动作（清空输入框）不能同时表示"保持"和"清除"——两者物理上不可区分。
  于是必须有一个明确说"我要删掉它"的地方，这就是这一项存在的全部理由。
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_clear_password"
        android:title="@string/connection_menu_clear_password"
        app:showAsAction="never" />

</menu>
